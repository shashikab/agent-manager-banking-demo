# Copy to .env for local runs. On Agent Manager, set these under Environment Variables instead.
AWS_BEARER_TOKEN_BEDROCK=your-amazon-bedrock-api-key
# To send model calls through an Agent Manager LLM provider (so its guardrails apply)
# instead of calling Bedrock directly, set these. Agent Manager injects the two
# LLM_PROVIDER_* values when a provider is attached; AWS_BEARER_TOKEN_BEDROCK is then unused.
# USE_LLM_PROVIDER=true
# LLM_PROVIDER_URL=<gateway URL>
# LLM_PROVIDER_KEY=<gateway key>
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# BANK_NAME=Demo Bank
# AGENT_VERSION=1.0.0
